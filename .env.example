PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/bookleaf.db

# ---- AI (server-side only). Without a key the app still works: rule-based triage + manual replies. ----
# Default = free-tier friendly, OpenAI-compatible provider. Pick ONE block.

# Option A: Groq (free tier) - key from console.groq.com
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Option B: Google Gemini (free tier via AI Studio)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash

# Option C: OpenRouter free models
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=<any model id ending in :free>

# Option D: local Ollama (fully free, no key needed but set any value)
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1:8b
# AI_API_KEY=ollama

# Option E: Claude
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-5-5
